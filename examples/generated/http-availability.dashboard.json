{
  "title": "SLO / checkout-api / availability",
  "uid": "slo-checkout-api-availability",
  "description": "99.9% of checkout-api HTTP requests succeed (non-5xx) over 30 days.",
  "tags": [
    "slo",
    "checkout-api"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SLI (objective 99.9%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - slo:sli_error:ratio_rate5m{service=\"checkout-api\", slo=\"availability\"}",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - slo:sli_error:ratio_rate1h{service=\"checkout-api\", slo=\"availability\"}",
          "legendFormat": "1h"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - ((sum(rate(http_requests_total{job=\"checkout-api\", code=~\"5..\"}[30d]))) / (sum(rate(http_requests_total{job=\"checkout-api\"}[30d])))) / 0.001",
          "legendFormat": "remaining"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Burn rate (1 = budget lasts exactly the SLO window)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slo:sli_error:ratio_rate5m{service=\"checkout-api\", slo=\"availability\"} / 0.001",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slo:sli_error:ratio_rate1h{service=\"checkout-api\", slo=\"availability\"} / 0.001",
          "legendFormat": "1h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slo:sli_error:ratio_rate6h{service=\"checkout-api\", slo=\"availability\"} / 0.001",
          "legendFormat": "6h"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slo:sli_error:ratio_rate1d{service=\"checkout-api\", slo=\"availability\"} / 0.001",
          "legendFormat": "1d"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "slo:sli_error:ratio_rate3d{service=\"checkout-api\", slo=\"availability\"} / 0.001",
          "legendFormat": "3d"
        }
      ]
    }
  ]
}
